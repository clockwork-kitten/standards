{
  "name": "@clockwork-kitten/conform",
  "version": "0.0.0",
  "description": "The clockwork-kitten conformance engine \u2014 one CLI that lints and (later) structurally edits conformant files.",
  "type": "module",
  "bin": {
    "conform": "./src/cli/main.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./configs/eslint.base": "./configs/eslint.base.js",
    "./configs/eslint.astro": "./configs/eslint.astro.js",
    "./configs/prettier.base.json": "./configs/prettier.base.json",
    "./configs/prettier.astro.json": "./configs/prettier.astro.json",
    "./configs/knip.base.json": "./configs/knip.base.json",
    "./configs/tsconfig.base.json": "./configs/tsconfig.base.json"
  },
  "files": [
    "src",
    "configs"
  ],
  "scripts": {
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "~3.1.0",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "jsonc-parser": "^3.3.1",
    "knip": "^6.34.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "~0.14.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.0.2",
    "vitest": "^3.0.2"
  }
}
