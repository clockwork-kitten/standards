  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.5",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^3.0.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
