{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@clockwork-kitten studio base",
  "_comment": "Strict, framework-agnostic base. Consumers extend this and supply target/module/moduleResolution/lib/types to match their runtime (Bun engine, SvelteKit UI, Astro site, Hono backend).",
  "compilerOptions": {
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  }
}
