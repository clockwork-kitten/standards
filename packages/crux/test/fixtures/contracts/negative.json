{
  "fixtureRevision": 1,
  "cases": [
    {
      "name": "bundle rejects version ranges",
      "schemaId": "https://schemas.clockwork-kitten.dev/crux/bundle/1",
      "from": "bundle",
      "patch": {
        "path": ["components", "canon", "package", "version"],
        "value": "^1.0.0"
      }
    },
    {
      "name": "lock rejects absolute policy input paths",
      "schemaId": "https://schemas.clockwork-kitten.dev/crux/lock/1",
      "from": "lock",
      "patch": {
        "path": ["effectivePolicyInputs", 0, "inputId"],
        "value": "/Users/example/repository/.conform/policy.jsonc"
      }
    },
    {
      "name": "lock rejects hostnames",
      "schemaId": "https://schemas.clockwork-kitten.dev/crux/lock/1",
      "from": "lock",
      "patch": {
        "path": ["hostname"],
        "value": "builder-01"
      }
    },
    {
      "name": "lock rejects installation layout fields",
      "schemaId": "https://schemas.clockwork-kitten.dev/crux/lock/1",
      "from": "lock",
      "patch": {
        "path": ["installationPath"],
        "value": "node_modules/@clockwork-kitten/crux"
      }
    },
    {
      "name": "lock rejects installation layout in effective policy input IDs",
      "schemaId": "https://schemas.clockwork-kitten.dev/crux/lock/1",
      "from": "lock",
      "patch": {
        "path": ["effectivePolicyInputs", 0, "inputId"],
        "value": "node_modules/layout"
      }
    },
    {
      "name": "bundle rejects missing manifest hashes for verdict tools",
      "schemaId": "https://schemas.clockwork-kitten.dev/crux/bundle/1",
      "from": "bundle",
      "patch": {
        "operation": "remove",
        "path": ["components", "tools", 0, "manifestHash"]
      }
    },
    {
      "name": "bundle rejects null manifest hashes for verdict tools",
      "schemaId": "https://schemas.clockwork-kitten.dev/crux/bundle/1",
      "from": "bundle",
      "patch": {
        "path": ["components", "tools", 0, "manifestHash"],
        "value": null
      }
    },
    {
      "name": "bundle rejects a result support window shorter than one minor",
      "schemaId": "https://schemas.clockwork-kitten.dev/crux/bundle/1",
      "from": "bundle",
      "patch": {
        "path": ["resultMajorSupport", "previous"],
        "value": {
          "major": 1,
          "minimumConformMinorReleases": 0,
          "minimumDays": 90
        }
      }
    },
    {
      "name": "bundle rejects a result support window shorter than 90 days",
      "schemaId": "https://schemas.clockwork-kitten.dev/crux/bundle/1",
      "from": "bundle",
      "patch": {
        "path": ["resultMajorSupport", "previous"],
        "value": {
          "major": 1,
          "minimumConformMinorReleases": 1,
          "minimumDays": 89
        }
      }
    },
    {
      "name": "result rejects noncanonical classifications",
      "schemaId": "https://schemas.clockwork-kitten.dev/crux/engine-result/1",
      "from": "engineResult",
      "patch": {
        "path": ["classification"],
        "value": "warning"
      }
    },
    {
      "name": "context rejects timestamps",
      "schemaId": "https://schemas.clockwork-kitten.dev/crux/context/1",
      "from": "context",
      "patch": {
        "path": ["generatedAt"],
        "value": "2026-11-22T00:00:00Z"
      }
    },
    {
      "name": "context rejects environment data",
      "schemaId": "https://schemas.clockwork-kitten.dev/crux/context/1",
      "from": "context",
      "patch": {
        "path": ["environment"],
        "value": {
          "nodeMajor": 24
        }
      }
    },
    {
      "name": "context rejects baseline contents",
      "schemaId": "https://schemas.clockwork-kitten.dev/crux/context/1",
      "from": "context",
      "patch": {
        "path": ["baseline"],
        "value": []
      }
    },
    {
      "name": "context rejects result data",
      "schemaId": "https://schemas.clockwork-kitten.dev/crux/context/1",
      "from": "context",
      "patch": {
        "path": ["result"],
        "value": {
          "classification": "pass"
        }
      }
    },
    {
      "name": "context rejects secrets",
      "schemaId": "https://schemas.clockwork-kitten.dev/crux/context/1",
      "from": "context",
      "patch": {
        "path": ["apiToken"],
        "value": "fixture-secret"
      }
    }
  ]
}
