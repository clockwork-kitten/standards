{
  "name": "@clockwork-kitten/standards-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:md": "conform check",
    "llms": "conform llms",
    "fix:md": "conform fix",
    "check:llms": "conform llms --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "deadcode": "knip",
    "test": "bun run --cwd packages/conform test",
    "typecheck": "bun run --cwd packages/conform typecheck"
  },
  "prettier": "@clockwork-kitten/conform/configs/prettier.base.json",
  "devDependencies": {
    "@clockwork-kitten/conform": "workspace:*",
    "lefthook": "^2.1.12"
  }
}
